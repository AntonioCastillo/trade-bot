# Copia este archivo a .env y rellena tus valores.
# El .env NUNCA se sube al repositorio (ver .gitignore).

# Credenciales de KuCoin — SOLO necesarias en modo live.
# En modo paper (por defecto) se pueden dejar vacías.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Credenciales de Bybit EU — solo si `exchange: bybiteu` (config.bybiteu.yaml).
# Bybit no usa passphrase. Crea la clave SIN permiso de retirada.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Notificaciones opcionales por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
